{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldforge.local/schemas/publish-manifest.schema.json",
  "title": "WorldForge JSON Publish Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "worldId", "definitionVersion", "sourceCommit", "compilerVersion", "contentSources", "selection", "mechanics", "initialState"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "worldId": { "type": "string", "pattern": "^W[0-9]{2}$" },
    "definitionVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "compilerVersion": { "const": "0.1.0" },
    "contentSources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultStatus", "experimentalIncludes"],
      "properties": {
        "defaultStatus": { "const": "canon" },
        "experimentalIncludes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "mechanics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "registryVersion", "modules"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "registryVersion": { "type": "string" },
        "modules": { "type": "array", "items": { "type": "object", "required": ["id", "version", "parameters"] } }
      }
    },
    "initialState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regions", "entities", "events"],
      "properties": {
        "regions": { "type": "array" },
        "entities": { "type": "array" },
        "events": { "type": "array" }
      }
    }
  }
}
