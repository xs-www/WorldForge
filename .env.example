# 复制为 .env.local，并填入你使用的模型服务。不要提交 .env.local。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
# OpenAI Responses API 使用 responses；兼容服务可改为 chat。
LLM_API_STYLE=responses
# 火山方舟 Seedream 卡面插画；密钥也可在界面设置。
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=doubao-seedream-5-0-flash-260915
# Docker 内访问宿主机 ComfyUI；非 Docker 启动可用 http://127.0.0.1:8188。
COMFYUI_BASE_URL=http://host.docker.internal:8188
# 可选：默认与内容数据库同目录，文件名为 worldforge-simulation.sqlite。
WORLDFORGE_SIM_DB_PATH=
# —— 作者资料库后端（多用户 / 多世界部署）——
# sqlite（默认，零依赖）或 postgres。留空时：有 WORLDFORGE_DATABASE_URL 就走 postgres，否则 sqlite。
WORLDFORGE_DB_DRIVER=
# PostgreSQL 连接串，例如 postgres://worldforge:password@nas:5432/worldforge
# 口令不会出现在 /api/health 或日志里；health 只显示 host:port/database。
WORLDFORGE_DATABASE_URL=
# 模拟存档（W98/W99）仍固定使用独立 SQLite 文件，暂不支持 PostgreSQL。
# —— 公网发布（Tailscale Funnel 等）才需要的账号配置 ——
# 打开 REQUIRE_AUTH 后若缺少 users.json，服务会拒绝启动，避免忘记建账号就公开。
# 先运行 node scripts/auth-cli.mjs add <用户名> --admin 创建账号库，再取消下面两行的注释。
# WORLDFORGE_REQUIRE_AUTH=1
# HTTPS 隧道后面必须设 1，浏览器才会以 Secure Cookie 传输会话。
# WORLDFORGE_COOKIE_SECURE=1
# 账号库路径；留空时默认取 .env.local 同目录的 users.json。
WORLDFORGE_AUTH_USERS_PATH=
PORT=8080
