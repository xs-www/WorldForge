# 复制为 .env.local，并填入你使用的模型服务。不要提交 .env.local。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
# OpenAI Responses API 使用 responses；兼容服务可改为 chat。
LLM_API_STYLE=responses
# 火山方舟 Seedream 卡面插画；密钥也可在界面设置。
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=doubao-seedream-5-0-flash-260915
# Docker 内访问宿主机 ComfyUI；非 Docker 启动可用 http://127.0.0.1:8188。
COMFYUI_BASE_URL=http://host.docker.internal:8188
# 可选：默认与内容数据库同目录，文件名为 worldforge-simulation.sqlite。
WORLDFORGE_SIM_DB_PATH=
PORT=8080
