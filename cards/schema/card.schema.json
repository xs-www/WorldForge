{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldforge.local/schema/card.schema.json",
  "title": "Worldforge Card",
  "type": "object",
  "required": ["id", "name", "status", "world_id", "card_type", "rarity", "cost", "stats", "keywords", "rules_text", "balance_status", "effects", "lore_refs"],
  "properties": {
    "id": { "type": "string", "pattern": "^CARD-W[0-9]{2}-[0-9]{4}$" },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["canon", "proposed", "deprecated"] },
    "world_id": { "type": "string", "pattern": "^W[0-9]{2}$" },
    "card_type": { "enum": ["minion", "spell", "equipment"] },
    "rarity": { "enum": ["common", "rare", "epic", "legendary"] },
    "cost": { "type": "number", "minimum": 0 },
    "stats": {
      "type": "object",
      "properties": {
        "attack": { "type": "number", "minimum": 0 },
        "health": { "type": "number", "minimum": 1 },
        "durability": { "type": "number", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^KEY-[0-9]{3}$" },
          "detail": { "type": "string", "maxLength": 160 }
        },
        "additionalProperties": false
      }
    },
    "rules_text": { "type": "string" },
    "lore_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "art_asset_id": { "type": ["string", "null"], "pattern": "^ART-[A-F0-9-]+$" },
    "balance_status": { "type": "string" },
    "effects": { "type": "array" }
  },
  "allOf": [
    { "if": { "properties": { "card_type": { "const": "minion" } } }, "then": { "properties": { "stats": { "required": ["attack", "health"], "not": { "required": ["durability"] } } } } },
    { "if": { "properties": { "card_type": { "const": "spell" } } }, "then": { "properties": { "stats": { "maxProperties": 0 } } } },
    { "if": { "properties": { "card_type": { "const": "equipment" } } }, "then": { "properties": { "stats": { "required": ["attack", "durability"], "not": { "required": ["health"] } } } } }
  ],
  "additionalProperties": true
}
